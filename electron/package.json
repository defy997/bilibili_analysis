{
  "name": "bilibili-floating-window",
  "version": "2.0.0",
  "description": "B站视频评论情感分析悬浮窗口",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "dev": "chcp 65001 >nul && set NODE_ENV=development&& electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "bilibili",
    "sentiment-analysis",
    "floating-window"
  ],
  "author": "BiliMood",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.bilimood.app",
    "productName": "BiliMood",
    "copyright": "Copyright © 2025 BiliMood",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!**/*.md",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../chrome_extension",
        "to": "chrome_extension",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BiliMood",
      "artifactName": "BiliMood-Setup-${version}.exe",
      "language": "2052"
    }
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "electron-reloader": "^1.2.3"
  },
  "dependencies": {
    "axios": "^1.13.3",
    "echarts": "^5.4.0",
    "vue": "^3.3.0",
    "ws": "^8.14.0"
  }
}
